{
  "name": "tabby-better-sidebar",
  "version": "0.3.0",
  "description": "Enhanced connection sidebar for Tabby: a contextual SFTP browser inside the sidebar itself, pinned favorites, live connection status, active sessions, workspaces, SSH tunnels, drag & drop (including dragging remote files out to the OS), a transfer manager, and a custom icon picker.",
  "keywords": [
    "tabby-plugin"
  ],
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/TooMuhtsh/tabby-better-sidebar.git"
  },
  "homepage": "https://github.com/TooMuhtsh/tabby-better-sidebar#readme",
  "bugs": {
    "url": "https://github.com/TooMuhtsh/tabby-better-sidebar/issues"
  },
  "scripts": {
    "build": "webpack --progress --color",
    "build:prod": "webpack --progress --color --mode production && node -e \"require('fs').rmSync('dist/index.js.map', { force: true })\"",
    "watch": "webpack --progress --color --watch",
    "lint:airules": "html-validate \".AIRules/**/*.html\"",
    "prepublishOnly": "npm run build:prod"
  },
  "files": [
    "dist"
  ],
  "author": "TooMuhtsh",
  "license": "MIT",
  "devDependencies": {
    "@angular/animations": "^15.0.0",
    "@angular/cdk": "^15.0.0",
    "@angular/common": "^15.0.0",
    "@angular/core": "^15.0.0",
    "@angular/forms": "^15.0.0",
    "@angular/platform-browser": "^15.0.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.37",
    "@ng-bootstrap/ng-bootstrap": "^14.2.0",
    "@types/node": "^18.19.0",
    "@types/webpack-env": "^1.16.0",
    "apply-loader": "^2.0.0",
    "css-loader": "^6.8.0",
    "dompurify": "^3.4.12",
    "filesize": "^11.0.22",
    "fuzzy-search": "^3.2.1",
    "html-validate": "^11.6.0",
    "pug": "^2.0.4",
    "pug-loader": "^2.4.0",
    "rxjs": "^7.3.0",
    "sass": "^1.60.0",
    "sass-loader": "^13.2.0",
    "style-loader": "^3.3.0",
    "tabby-core": "^1.0.231-nightly.0",
    "tabby-settings": "^1.0.231-nightly.0",
    "tabby-terminal": "^1.0.231-nightly.0",
    "ts-loader": "^9.4.0",
    "typescript": "^4.9.5",
    "webpack": "^5.24.4",
    "webpack-cli": "^4.5.0"
  }
}
