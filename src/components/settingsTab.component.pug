//- One `.form-line` per setting — label and short explanation on the left,
//- control on the right. The wording stays in French: unlike the other plugin,
//- this one ships no `src/i18n/`, so a `| translate` would resolve to the
//- source string anyway.
//-
//- Two rules hold this page together, both the user's:
//-
//- 1. A setting lives with the switch of the feature it belongs to, so
//-    switching that feature off takes its options off the page with it. Only
//-    what applies to the whole plugin — or to Tabby itself — stays on the
//-    general page. A setting outliving its feature on screen reads as broken
//-    rather than as irrelevant.
//- 2. Descriptions are one or two lines. What a setting does and what its
//-    default is, nothing more: the reasoning behind each one belongs in
//-    .AIRules, not in front of someone trying to flip a switch.
.sidebar-plus-settings
  ul.nav.nav-tabs.sidebar-plus-settings-nav
    li.nav-item
      a.nav-link(href='#', [class.active]="section === 'general'", (click)="setSection('general', $event)") Général
    li.nav-item
      a.nav-link(href='#', [class.active]="section === 'features'", (click)="setSection('features', $event)") Fonctionnalités
    //- Disparaît avec l'interrupteur du bloc, comme toute option qui n'existe
    //- que pour une fonctionnalité : un onglet qui survit à ce qu'il règle se
    //- lit comme cassé plutôt que comme sans objet.
    li.nav-item(*ngIf="blockOn('showSnippets')")
      a.nav-link(href='#', [class.active]="section === 'snippets'", (click)="setSection('snippets', $event)") Snippets
    //- Les pages des autres plugins « Better * », quand ce plugin héberge
    //- l'onglet unifié « Better Tabby » (voir betterPanel.ts). Vide sinon.
    li.nav-item(*ngFor='let panel of externalPanels')
      a.nav-link(href='#', [class.active]="section === 'ext:' + panel.id", (click)="setSection('ext:' + panel.id, $event)") {{panel.title}}

  ng-container(*ngIf="section === 'general'")
    .settings-section
      h3 Général

      .form-line
        .header
          .title Afficher la sidebar #[i.fas.fa-info-circle.info-hint(title="Le plugin retire son nœud du DOM et rend à Tabby tout ce qu il masquait. Rien n est désinstallé ni perdu.")]
          .description Décoché, la sidebar est retirée et Tabby retrouve son état d'origine. Cette page reste accessible.
        .control
          toggle(
            [ngModel]='enabled',
            (ngModelChange)='setEnabled($event)'
          )

      .form-line
        .header
          .title Masquer le menu des transferts de Tabby #[i.fas.fa-info-circle.info-hint(title="Le menu natif est téléporté dans le body : c est lui qui est visé, pas seulement son bouton. Ses lignes ne s effacent qu une par une, à la main.")]
          .description Le gestionnaire de la sidebar montre les mêmes transferts. Laissé visible, le menu natif s'ouvre de lui-même à chaque transfert.
        .control
          toggle(
            [ngModel]='hideNativeTransfersMenu',
            (ngModelChange)='setHideNativeTransfersMenu($event)'
          )

  ng-container(*ngIf="section === 'features'")
    .settings-section
      .section-intro
        | Chaque bloc s'allume et s'éteint ici, avec ses réglages sous son
        | interrupteur. Éteindre coupe aussi ce qui l'alimente — rien n'est
        | supprimé, tout revient en rallumant.


    //- Les blocs sans réglage propre, groupés et resserrés en tête : ce sont
        de simples interrupteurs, et les étaler comme ceux qui ouvrent une
        liste d'options laissait croire qu'ils en avaient aussi.
    .settings-section.compact-blocks
      .form-line.block-switch
        .header
          .title Tunnels actifs #[i.fas.fa-info-circle.info-hint(title="Reflet de l état du moteur de port-forwarding de Tabby. Pastille allumée quand des tunnels sont montés, estompée quand le profil en porte seulement en configuration.")]
          .description Le panneau des redirections de ports, et les pastilles « maillon » sur les profils.
          .description.text-warning(*ngIf="!hostHas('ssh-tab')") Indisponible sur cette version de Tabby. Votre réglage est conservé.
        .control
          toggle(
            [ngModel]="blockOn('showTunnels', 'ssh-tab')",
            [disabled]="!hostHas('ssh-tab')",
            (ngModelChange)="setBlock('showTunnels', $event)"
          )

      .form-line.block-switch
        .header
          .title Workspaces #[i.fas.fa-info-circle.info-hint(title="Les workspaces filtrent la visibilité, ils ne suppriment rien. « Tous » est le cas sans exclusion. La barre de filtrage, elle, cherche partout quoi qu il arrive.")]
          .description La barre des espaces de travail. Éteinte, la sidebar revient sur « Tous » et tout redevient visible.
        .control
          toggle(
            [ngModel]="blockOn('showWorkspaces')",
            (ngModelChange)="setBlock('showWorkspaces', $event)"
          )

      .form-line.block-switch
        .header
          .title Barre de filtrage #[i.fas.fa-info-circle.info-hint(title="Cherche le nom, la description, l hôte et l utilisateur, et ignore délibérément le masquage du workspace actif. Éteinte, le raccourci reste sans effet plutôt que de paraître cassé.")]
          .description Le champ de recherche et son raccourci #[kbd Ctrl+F].
        .control
          toggle(
            [ngModel]="blockOn('showFilter')",
            (ngModelChange)="setBlock('showFilter', $event)"
          )

      .form-line.block-switch
        .header
          .title Snippets #[i.fas.fa-info-circle.info-hint(title="Une bibliothèque de commandes rattachées aux profils et aux dossiers. Éteint, l onglet de la bibliothèque disparaît aussi, et une session qui s ouvre ne vérifie plus les variables. Rien n est supprimé : tout revient en rallumant.")]
          .description L'entrée « Snippets… » du clic droit, et l'onglet de la bibliothèque.
        .control
          toggle(
            [ngModel]="blockOn('showSnippets')",
            (ngModelChange)="setBlock('showSnippets', $event)"
          )

      .form-line.block-switch
        .header
          .title Notes #[i.fas.fa-info-circle.info-hint(title="Un mémento libre par profil ou dossier. Éteintes, les pastilles disparaissent et la barre de filtrage cesse de chercher dedans. Les notes écrites sont conservées.")]
          .description L'entrée « note » du clic droit, et la pastille sur les lignes concernées.
        .control
          toggle(
            [ngModel]="blockOn('showNotes')",
            (ngModelChange)="setBlock('showNotes', $event)"
          )

    //- SESSIONS ACTIVES
    .settings-section
      .form-line.block-switch
        .header
          .title Sessions actives #[i.fas.fa-info-circle.info-hint(title="Une ligne par pane, pas par onglet. Le clic déplace le focus sur la session, y compris dans un split. Éteinte, le balayage des onglets toutes les 2 s s arrête.")]
          .description La liste des connexions SSH ouvertes, en haut de la sidebar.
          .description.text-warning(*ngIf="!hostHas('ssh-tab')") Indisponible sur cette version de Tabby. Votre réglage est conservé.
        .control
          toggle(
            [ngModel]="blockOn('showActiveSessions', 'ssh-tab')",
            [disabled]="!hostHas('ssh-tab')",
            (ngModelChange)="setBlock('showActiveSessions', $event)"
          )

      .block-options(*ngIf="blockOn('showActiveSessions', 'ssh-tab')")
        .form-line
          .header
            .title Mesure de latence, en secondes #[i.fas.fa-info-circle.info-hint(title="Aller-retour SFTP sur la session elle-même, donc le délai ressenti à la frappe — pas un ping ICMP vers l hôte, que bien des pare-feux bloquent. Pastille verte sous 80 ms, orange sous 250 ms, rouge au-delà, grise sans mesure. Un serveur sans sous-système SFTP n est plus sollicité.")]
            .description Colore la pastille de chaque session. 0 désactive — chaque mesure est une vraie requête au serveur.
          .control
            input#sidebar-plus-ping-interval.form-control(
              type='number',
              min='0',
              step='1',
              [ngModel]='pingIntervalSeconds',
              (ngModelChange)='setPingIntervalSeconds($event)'
            )

    //- VUE SFTP — de loin le bloc le plus outillé
    .settings-section
      .form-line.block-switch
        .header
          .title Vue SFTP #[i.fas.fa-info-circle.info-hint(title="Éteinte, les panneaux gardés en cache sont libérés et l onglet disparaît de la barre de mode. La rallumer rouvre un canal SFTP par session réellement parcourue.")]
          .description L'onglet SFTP de la sidebar et son panneau.
          .description.text-warning(*ngIf="!hostHas('sftp-panel')") Indisponible sur cette version de Tabby. Votre réglage est conservé.
        .control
          toggle(
            [ngModel]="blockOn('showSftp', 'sftp-panel')",
            [disabled]="!hostHas('sftp-panel')",
            (ngModelChange)="setBlock('showSftp', $event)"
          )

      .block-options(*ngIf="blockOn('showSftp', 'sftp-panel')")
        //- `stacked` : le chemin passe sous son intitulé et prend toute la largeur.
            Sur la même ligne que les deux boutons, il ne restait au champ que
            quelques caractères visibles — un chemin d'exécutable n'y tenait pas.
        .form-line.stacked
          .header
            .title Éditeur des fichiers distants #[i.fas.fa-info-circle.info-hint(title="Le fichier est copié en local, ouvert, puis renvoyé au serveur à chaque enregistrement, avec détection de conflit. L association du système exécuterait un programme au lieu de l éditer — d où l éditeur imposé.")]
            .description Le double-clic ouvre toujours ce programme, jamais l'association du système. Vide, Windows demande à chaque fois.
          .control
            input#sidebar-plus-editor-path.form-control(
              type='text',
              [(ngModel)]='editorPath',
              (change)='save()',
              [title]='editorPath',
              placeholder='Aucun éditeur choisi'
            )
            button.btn.btn-primary((click)='browse()')
              i.fas.fa-folder-open
              | Parcourir...
            button.btn.btn-secondary(*ngIf='editorPath', (click)='clear()')
              i.fas.fa-times
              | Effacer

        //- `toggle`, Tabby's own component, and not a bare
        //- `input.form-check-input`: Bootstrap only draws a check *inside* a
        //- `.form-check.form-switch` wrapper, so a lone input rendered as a
        //- transparent square — invisible on the dark theme once unticked, which
        //- read as a missing control rather than an unticked one. `toggle` brings
        //- that wrapper and matches the switches of Tabby's own settings pages.
        .form-line
          .header
            .title Glisser un dossier vers l'Explorateur #[i.fas.fa-info-circle.info-hint(title="Un fichier part en un seul geste, sans copie préalable. Un dossier passe par un marqueur déposé à la destination pour la retrouver, puis est livré par SFTP.")]
            .description Un dossier est téléchargé en entier avant le dépôt. Au-delà de 25 fichiers ou 20 Mo, une confirmation est demandée.
          .control
            toggle(
              [ngModel]='dragOutFolders',
              (ngModelChange)='setDragOutFolders($event)'
            )

        .form-line
          .header
            .title Rafraîchissement automatique, en secondes #[i.fas.fa-info-circle.info-hint(title="Seules les entrées qui ont changé sont redessinées. Le cycle est sauté tant qu un menu est ouvert, qu un chemin se saisit ou qu une suppression est en cours.")]
            .description SFTP ne signale aucun changement. 0 désactive — chaque cycle relit tout le dossier.
          .control
            input#sidebar-plus-auto-refresh.form-control(
              type='number',
              min='0',
              step='1',
              [ngModel]='autoRefreshSeconds',
              (ngModelChange)='setAutoRefreshSeconds($event)'
            )

        .form-line
          .header
            .title Suppression : bouton activé par Entrée #[i.fas.fa-info-circle.info-hint(title="La confirmation est une modale HTML, jamais un dialogue système. Le défaut prudent évite qu une frappe réflexe supprime : il n y a pas d annulation.")]
            .description S'applique à la touche #[kbd Suppr] comme au clic droit. #[kbd Échap] annule toujours.
          .control
            select#sidebar-plus-delete-default.form-control(
              [ngModel]='deleteDefaultButton',
              (ngModelChange)='setDeleteDefaultButton($event)'
            )
              option(value='cancel') Annuler — la réponse sûre (défaut)
              option(value='confirm') Supprimer — Suppr puis Entrée en un geste

        .form-line
          .header
            .title Gestionnaire de transferts #[i.fas.fa-info-circle.info-hint(title="Reflète tous les transferts de l application, y compris ceux du panneau SFTP natif et des autres plugins — d où sa dépendance à la vue SFTP, qui est leur source habituelle. Éteint, ni historique ni minuterie ne tournent, et le menu de transferts de Tabby cesse d être masqué pour qu il reste un affichage.")]
            .description Le panneau en bas de sidebar. Éteint, plus rien n'est suivi.
          .control
            toggle(
              [ngModel]="blockOn('showTransfers')",
              (ngModelChange)="setBlock('showTransfers', $event)"
            )

  //- The library. Commands are written here and nowhere else: the sidebar's
  //- context menu only attaches, detaches and runs them, because a 300px popup
  //- is the wrong place to edit anything shaped like code.
  //- Le bloc est retesté ici, pas seulement sur l'onglet : l'interrupteur vit
  //- dans « Fonctionnalités », donc on ne peut pas l'éteindre depuis cette page
  //- — mais une autre fenêtre Tabby le peut, `config.changed$` étant diffusé
  //- entre elles. Sans cela, la bibliothèque resterait affichée sous un onglet
  //- disparu.
  ng-container(*ngIf="section === 'snippets' && blockOn('showSnippets')")
    .settings-section
      .section-intro
        | Une commande écrite une fois, rattachée aux profils et aux dossiers où
        | elle sert. La modifier ici la corrige partout. Ce qui change d'un
        | serveur à l'autre s'écrit #[code {{ '{{variable}}' }}] et se renseigne
        | par le clic droit sur le profil.

      .snippet-library(*ngIf='!draft')
        .snippet-empty(*ngIf='!snippets.length')
          | Aucun snippet pour l'instant.
        //- Boxed and set apart from the section's own intro: as a plain line of
        //- text under it, it read as more explanation rather than as a state.
        .snippet-unused-summary(*ngIf='unusedCount')
          strong {{ unusedCount }} snippet(s) rattachés à rien.
          |  Détachés depuis la sidebar, ils restent ici jusqu'à suppression.
        .snippet-item(*ngFor='let s of snippets')
          .snippet-item-head
            .snippet-item-name {{ s.name }}
            .snippet-item-uses(*ngIf='attachmentCount(s)') rattaché à {{ attachmentCount(s) }} élément(s)
            .snippet-item-uses.unused(*ngIf='!attachmentCount(s)') rattaché nulle part
            .snippet-item-actions
              button.btn.btn-sm.btn-secondary((click)='editSnippet(s)') Modifier
              button.btn.btn-sm.btn-danger((click)='deleteSnippet(s)') Supprimer
          pre.snippet-item-command {{ s.command }}
          .snippet-item-vars(*ngIf='variablesOf(s).length')
            span.snippet-var-chip(*ngFor='let v of variablesOf(s)', [class.required]='v.required')
              | {{ v.name }}
              span(*ngIf='v.required') &nbsp;*
        button.btn.btn-primary.mt-3((click)='newSnippet()') Nouveau snippet

      .snippet-editor(*ngIf='draft')
        .form-line
          .header
            .title Nom
            .description Ce que montre le menu contextuel.
          .control
            input.form-control(type='text', [(ngModel)]='draft.name', placeholder='Redémarrer nginx')
        .form-line.stacked
          .header
            .title Commande
            .description
              | Écrivez #[code {{ '{{nom}}' }}] pour une valeur attendue du profil, ou
              | #[code {{ '{{nom=valeur}}' }}] pour une valeur par défaut. Sans défaut,
              | la variable est obligatoire : le snippet refuse de partir tant qu'elle
              | n'est pas renseignée. Entourez de guillemets — #[code cd "{{ '{{dir}}' }}"] —
              | toute variable pouvant contenir un espace ; l'écran des variables le
              | signale au cas par cas.
          .control
            textarea.form-control.snippet-editor-command(rows='6', [(ngModel)]='draft.command', placeholder='sudo systemctl restart nginx')
        //- No behaviour settings here: they belong to the pairing of a snippet
        //- with a profile or a folder, not to the command in the abstract. They
        //- are set by the right-click, where that pairing exists.
        .snippet-editor-actions
          button.btn.btn-primary((click)='saveDraft()') Enregistrer
          button.btn.btn-secondary((click)='cancelEdit()') Annuler
          .snippet-editor-warning(*ngIf='draft.id && attachmentCount(draft)')
            | Modifie la commande sur les {{ attachmentCount(draft) }} rattachement(s) existants.

  //- Les pages embarquées des autres plugins « Better * ». Pas de
  //- `.settings-section` autour : chaque composant embarqué apporte sa propre
  //- mise en page, et l'injecteur qu'on lui passe porte le marqueur
  //- BetterPanelEmbedded qui lui dit qu'il est un sous-onglet.
  ng-container(*ngFor='let panel of externalPanels')
    ng-container(*ngIf="section === 'ext:' + panel.id")
      ng-container(*ngComponentOutlet='panel.componentType; injector: embedInjector')
