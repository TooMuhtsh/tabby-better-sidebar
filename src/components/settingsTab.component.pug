//- One `.form-line` per setting — label and short explanation on the left,
//- control on the right.
//-
//- Three rules hold this page together:
//-
//- 1. A setting lives with the switch of the feature it belongs to, so
//-    switching that feature off takes its options off the page with it. Only
//-    what applies to the whole plugin — or to Tabby itself — stays on the
//-    general page. A setting outliving its feature on screen reads as broken
//-    rather than as irrelevant.
//- 2. Descriptions and tooltips are ONE short sentence each (user's rule,
//-    2026-08-08): the setting's label already says what it is, so the
//-    sentence says only what it does, never the internal justification —
//-    that belongs in .AIRules, not in front of someone trying to flip a
//-    switch. NO string literal ever appears inline in this template: every
//-    user-visible string is a component property (`lbl*` getters backed by
//-    SidebarPlusI18nService) bound via `{{ lblX }}` or `[title]='lblX'` —
//-    an inline literal with a straight apostrophe or an em dash broke the
//-    JIT compiler across the whole tab (piège vécu ici même, 2026-08-08).
//- 3. Every setting keeps working exactly as before: only the wording moved
//-    into the component.
.sidebar-plus-settings
  //- En-tête calqué sur celui de Better Vault (h3 + ligne secondaire, au-dessus
  //- des sous-onglets) : les deux plugins partagent le même panneau, et leurs
  //- pages doivent s'ouvrir de la même façon. Libellés portés par des
  //- propriétés `lbl*` comme tout ce gabarit — jamais de littéral inline ici,
  //- c'est ce qui avait cassé le JIT au lot 2 de l'i18n.
  h3.mb-1 {{ lblPageTitle }}
  .sidebar-plus-settings-subtitle.mb-3 {{ lblPageSubtitle }}

  ul.nav.nav-tabs.sidebar-plus-settings-nav
    li.nav-item
      a.nav-link(href='#', [class.active]="section === 'general'", (click)="setSection('general', $event)") {{ lblGeneral }}
    li.nav-item
      a.nav-link(href='#', [class.active]="section === 'features'", (click)="setSection('features', $event)") {{ lblFeatures }}
    //- Disparaît avec l'interrupteur du bloc, comme toute option qui n'existe
    //- que pour une fonctionnalité : un onglet qui survit à ce qu'il règle se
    //- lit comme cassé plutôt que comme sans objet.
    li.nav-item(*ngIf="blockOn('showSnippets')")
      a.nav-link(href='#', [class.active]="section === 'snippets'", (click)="setSection('snippets', $event)") Snippets

  ng-container(*ngIf="section === 'general'")
    .settings-section
      h3 {{ lblGeneral }}

      .form-line
        .header
          .title {{ lblShowSidebar }} #[i.fas.fa-info-circle.info-hint([title]='lblShowSidebarHint')]
          .description {{ lblShowSidebarDesc }}
        .control
          toggle(
            [ngModel]='enabled',
            (ngModelChange)='setEnabled($event)'
          )

      .form-line
        .header
          .title {{ lblHideTransfersMenu }} #[i.fas.fa-info-circle.info-hint([title]='lblHideTransfersMenuHint')]
          .description {{ lblHideTransfersMenuDesc }}
        .control
          toggle(
            [ngModel]='hideNativeTransfersMenu',
            (ngModelChange)='setHideNativeTransfersMenu($event)'
          )

  ng-container(*ngIf="section === 'features'")
    .settings-section
      .section-intro
        | {{ lblFeaturesIntro }}


    //- Les blocs sans réglage propre, groupés et resserrés en tête : ce sont
        de simples interrupteurs, et les étaler comme ceux qui ouvrent une
        liste d'options laissait croire qu'ils en avaient aussi.
    .settings-section.compact-blocks
      .form-line.block-switch
        .header
          .title {{ lblTunnels }} #[i.fas.fa-info-circle.info-hint([title]='lblTunnelsHint')]
          .description {{ lblTunnelsDesc }}
          .description.text-warning(*ngIf="!hostHas('ssh-tab')") {{ lblUnavailable }}
        .control
          toggle(
            [ngModel]="blockOn('showTunnels', 'ssh-tab')",
            [disabled]="!hostHas('ssh-tab')",
            (ngModelChange)="setBlock('showTunnels', $event)"
          )

      .form-line.block-switch
        .header
          .title {{ lblWorkspaces }} #[i.fas.fa-info-circle.info-hint([title]='lblWorkspacesHint')]
          .description {{ lblWorkspacesDesc }}
        .control
          toggle(
            [ngModel]="blockOn('showWorkspaces')",
            (ngModelChange)="setBlock('showWorkspaces', $event)"
          )

      .block-options(*ngIf="blockOn('showWorkspaces')")
        .form-line
          .header
            .title {{ lblPresentation }} #[i.fas.fa-info-circle.info-hint([title]='lblPresentationHint')]
            .description {{ lblPresentationDesc }}
          .control
            select#sidebar-plus-workspace-selector-mode.form-control(
              [ngModel]='workspaceSelectorMode',
              (ngModelChange)='setWorkspaceSelectorMode($event)'
            )
              option(value='tabs') {{ lblModeTabs }}
              option(value='dropdown') {{ lblModeDropdown }}

      .form-line.block-switch
        .header
          .title {{ lblFilterBar }} #[i.fas.fa-info-circle.info-hint([title]='lblFilterBarHint')]
          .description {{ lblFilterBarDesc }} #[kbd Ctrl+F].
        .control
          toggle(
            [ngModel]="blockOn('showFilter')",
            (ngModelChange)="setBlock('showFilter', $event)"
          )

      .form-line.block-switch
        .header
          .title Snippets #[i.fas.fa-info-circle.info-hint([title]='lblSnippetsHint')]
          .description {{ lblSnippetsDesc }}
        .control
          toggle(
            [ngModel]="blockOn('showSnippets')",
            (ngModelChange)="setBlock('showSnippets', $event)"
          )

      .form-line.block-switch
        .header
          .title {{ lblNotes }} #[i.fas.fa-info-circle.info-hint([title]='lblNotesHint')]
          .description {{ lblNotesDesc }}
        .control
          toggle(
            [ngModel]="blockOn('showNotes')",
            (ngModelChange)="setBlock('showNotes', $event)"
          )

      .form-line.block-switch
        .header
          .title {{ lblRecentProfiles }} #[i.fas.fa-info-circle.info-hint([title]='lblRecentProfilesHint')]
          .description {{ lblRecentProfilesDesc }}
        .control
          toggle(
            [ngModel]="blockOn('showRecentProfiles')",
            (ngModelChange)="setBlock('showRecentProfiles', $event)"
          )

    //- SESSIONS ACTIVES
    .settings-section
      .form-line.block-switch
        .header
          .title {{ lblActiveSessions }} #[i.fas.fa-info-circle.info-hint([title]='lblActiveSessionsHint')]
          .description {{ lblActiveSessionsDesc }}
          .description.text-warning(*ngIf="!hostHas('ssh-tab')") {{ lblUnavailable }}
        .control
          toggle(
            [ngModel]="blockOn('showActiveSessions', 'ssh-tab')",
            [disabled]="!hostHas('ssh-tab')",
            (ngModelChange)="setBlock('showActiveSessions', $event)"
          )

      .block-options(*ngIf="blockOn('showActiveSessions', 'ssh-tab')")
        .form-line
          .header
            .title {{ lblPing }} #[i.fas.fa-info-circle.info-hint([title]='lblPingHint')]
            .description {{ lblPingDesc }}
          .control
            input#sidebar-plus-ping-interval.form-control(
              type='number',
              min='0',
              step='1',
              [ngModel]='pingIntervalSeconds',
              (ngModelChange)='setPingIntervalSeconds($event)'
            )

    //- VUE SFTP — de loin le bloc le plus outillé
    .settings-section
      .form-line.block-switch
        .header
          .title {{ lblSftp }} #[i.fas.fa-info-circle.info-hint([title]='lblSftpHint')]
          .description {{ lblSftpDesc }}
          .description.text-warning(*ngIf="!hostHas('sftp-panel')") {{ lblUnavailable }}
        .control
          toggle(
            [ngModel]="blockOn('showSftp', 'sftp-panel')",
            [disabled]="!hostHas('sftp-panel')",
            (ngModelChange)="setBlock('showSftp', $event)"
          )

      .block-options(*ngIf="blockOn('showSftp', 'sftp-panel')")
        //- `stacked` : le chemin passe sous son intitulé et prend toute la largeur.
            Sur la même ligne que les deux boutons, il ne restait au champ que
            quelques caractères visibles — un chemin d'exécutable n'y tenait pas.
        .form-line.stacked
          .header
            .title {{ lblEditor }} #[i.fas.fa-info-circle.info-hint([title]='lblEditorHint')]
            .description {{ lblEditorDesc }}
          .control
            input#sidebar-plus-editor-path.form-control(
              type='text',
              [(ngModel)]='editorPath',
              (change)='save()',
              [title]='editorPath',
              [placeholder]='lblEditorPlaceholder'
            )
            button.btn.btn-primary((click)='browse()')
              i.fas.fa-folder-open
              | {{ lblBrowse }}
            button.btn.btn-secondary(*ngIf='editorPath', (click)='clear()')
              i.fas.fa-times
              | {{ lblClear }}

        //- `toggle`, Tabby's own component, and not a bare
        //- `input.form-check-input`: Bootstrap only draws a check *inside* a
        //- `.form-check.form-switch` wrapper, so a lone input rendered as a
        //- transparent square — invisible on the dark theme once unticked, which
        //- read as a missing control rather than an unticked one. `toggle` brings
        //- that wrapper and matches the switches of Tabby's own settings pages.
        .form-line
          .header
            .title {{ lblDragOut }} #[i.fas.fa-info-circle.info-hint([title]='lblDragOutHint')]
            .description {{ lblDragOutDesc }}
          .control
            toggle(
              [ngModel]='dragOutFolders',
              (ngModelChange)='setDragOutFolders($event)'
            )

        .form-line
          .header
            .title {{ lblAutoRefresh }} #[i.fas.fa-info-circle.info-hint([title]='lblAutoRefreshHint')]
            .description {{ lblAutoRefreshDesc }}
          .control
            input#sidebar-plus-auto-refresh.form-control(
              type='number',
              min='0',
              step='1',
              [ngModel]='autoRefreshSeconds',
              (ngModelChange)='setAutoRefreshSeconds($event)'
            )

        .form-line
          .header
            .title {{ lblAutoReturn }} #[i.fas.fa-info-circle.info-hint([title]='lblAutoReturnHint')]
            .description {{ lblAutoReturnDesc }}
          .control
            toggle(
              [ngModel]='autoReturnToProfiles',
              (ngModelChange)='setAutoReturnToProfiles($event)'
            )

        .form-line
          .header
            .title {{ lblDeleteDefault }} #[i.fas.fa-info-circle.info-hint([title]='lblDeleteDefaultHint')]
            .description {{ lblDeleteApplies }} #[kbd {{ lblKeyDel }}] {{ lblDeleteRightClick }} #[kbd {{ lblKeyEsc }}] {{ lblDeleteEscape }}
          .control
            select#sidebar-plus-delete-default.form-control(
              [ngModel]='deleteDefaultButton',
              (ngModelChange)='setDeleteDefaultButton($event)'
            )
              option(value='cancel') {{ lblOptionCancel }}
              option(value='confirm') {{ lblOptionConfirm }}

        .form-line
          .header
            .title {{ lblTransfers }} #[i.fas.fa-info-circle.info-hint([title]='lblTransfersHint')]
            .description {{ lblTransfersDesc }}
          .control
            toggle(
              [ngModel]="blockOn('showTransfers')",
              (ngModelChange)="setBlock('showTransfers', $event)"
            )

  //- The library. Commands are written here and nowhere else: the sidebar's
  //- context menu only attaches, detaches and runs them, because a 300px popup
  //- is the wrong place to edit anything shaped like code.
  //- Le bloc est retesté ici, pas seulement sur l'onglet : l'interrupteur vit
  //- dans « Fonctionnalités », donc on ne peut pas l'éteindre depuis cette page
  //- — mais une autre fenêtre Tabby le peut, `config.changed$` étant diffusé
  //- entre elles. Sans cela, la bibliothèque resterait affichée sous un onglet
  //- disparu.
  ng-container(*ngIf="section === 'snippets' && blockOn('showSnippets')")
    .settings-section
      .section-intro
        | {{ lblSnippetsIntro }}

      .snippet-library(*ngIf='!draft')
        .snippet-empty(*ngIf='!snippets.length')
          | {{ lblNoSnippets }}
        //- Boxed and set apart from the section's own intro: as a plain line of
        //- text under it, it read as more explanation rather than as a state.
        .snippet-unused-summary(*ngIf='unusedCount')
          strong {{ lblUnusedSummary }}
          |  {{ lblUnusedDetail }}
        .snippet-item(*ngFor='let s of snippets')
          .snippet-item-head
            .snippet-item-name {{ s.name }}
            .snippet-item-uses(*ngIf='attachmentCount(s)') {{ attachedToLabel(s) }}
            .snippet-item-uses.unused(*ngIf='!attachmentCount(s)') {{ lblAttachedNowhere }}
            .snippet-item-actions
              button.btn.btn-sm.btn-secondary((click)='editSnippet(s)') {{ lblEdit }}
              button.btn.btn-sm.btn-danger((click)='deleteSnippet(s)') {{ lblDelete }}
          pre.snippet-item-command {{ s.command }}
          .snippet-item-vars(*ngIf='variablesOf(s).length')
            span.snippet-var-chip(*ngFor='let v of variablesOf(s)', [class.required]='v.required')
              | {{ v.name }}
              span(*ngIf='v.required') &nbsp;*
        button.btn.btn-primary.mt-3((click)='newSnippet()') {{ lblNewSnippet }}

      .snippet-editor(*ngIf='draft')
        .form-line
          .header
            .title {{ lblName }}
            .description {{ lblNameDesc }}
          .control
            input.form-control(type='text', [(ngModel)]='draft.name', [placeholder]='lblNamePlaceholder')
        .form-line.stacked
          .header
            .title {{ lblCommand }}
            //- Les jetons d'exemple restent statiques ({{nom}}) dans toutes les
            //- langues : un « {nom} » dans une valeur de table ressemblerait à
            //- un paramètre ICU inventé et ferait échouer lint:i18n.
            .description
              | {{ lblCommandUse }} #[code {{ '{{nom}}' }}] {{ lblCommandRequired }}
              | #[code {{ '{{nom=valeur}}' }}] {{ lblCommandDefault }}
          .control
            textarea.form-control.snippet-editor-command(rows='6', [(ngModel)]='draft.command', placeholder='sudo systemctl restart nginx')
        //- No behaviour settings here: they belong to the pairing of a snippet
        //- with a profile or a folder, not to the command in the abstract. They
        //- are set by the right-click, where that pairing exists.
        .snippet-editor-actions
          button.btn.btn-primary((click)='saveDraft()') {{ lblSave }}
          button.btn.btn-secondary((click)='cancelEdit()') {{ lblCancel }}
          .snippet-editor-warning(*ngIf='draft.id && attachmentCount(draft)')
            | {{ lblDraftWarning }}
