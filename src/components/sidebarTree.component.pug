        span.me-auto {{ 'Manage' | translate }}
        .fa.fa-fw.fas.fa-chevron-right
    a.group-context-menu-item(
        (click)='openSubmenuPanel("more", $event)',
        (mouseenter)='openSubmenuPanel("more", $event)',
        (mouseleave)='scheduleSubmenuClose()',
