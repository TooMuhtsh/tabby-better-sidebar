//- Opened by .workspace-bar-compact (openWorkspaceSwitcher()) — the same
//- entries .workspace-bar itself would show, one per row instead of one per
//- tab. NOT a contextMenuMode popup: it has its own flag and its own fixed
//- coordinates (anchored under the compact bar), so the manage popups opened
//- from its "⋯" buttons render BESIDE it while it stays on screen — see the
//- workspaceSwitcherOpen field's comment in the .ts. Left-click on a row
//- switches workspace and closes it (terminal action, inside
//- selectWorkspace()). Management goes through the row's own "⋯" button, not
//- a right-click on the row — see onWorkspaceTabContextMenu()'s comment for
//- why that was tried and reverted.
.group-context-menu.workspace-switcher-menu(
    *ngIf='workspaceSwitcherOpen',
    [style.left.px]='workspaceSwitcherX',
    [style.top.px]='workspaceSwitcherY',
    (click)='$event.stopPropagation()'
)
    a.group-context-menu-item(
        [class.active]='activeWorkspaceId === "all"',
        (click)='selectWorkspace("all")',
        href='#'
    ) {{ 'All' | translate }}
    a.group-context-menu-item(
        *ngFor='let ws of workspaces',
        [class.active]='activeWorkspaceId === ws.id',
        (click)='selectWorkspace(ws.id)',
        [title]='ws.name',
        href='#'
    )
        profile-icon.me-2(*ngIf='ws.icon', [icon]='ws.icon')
        span.me-auto.no-wrap {{ ws.name }}
        .workspace-color-dot(*ngIf='ws.color', [style.background-color]='ws.color')
        //- A `div`, not a nested `a`: the row itself is already `a.group-
        //- context-menu-item`, and an anchor inside an anchor is invalid HTML
        //- that the parser silently un-nests (same reasoning as the SFTP
        //- drag shortcut and the profile row's own .action buttons — see
        //- .actions/.action above for the established pattern). The event is
        //- passed for its stopPropagation() only — it keeps this from also
        //- bubbling into the row's own (click)='selectWorkspace(...)' above
        //- (same pattern as focusTunnelSession()) — never for its
        //- coordinates: the menu anchors on the switcher's edge, one fixed
        //- spot for every row (see switcherPopupAnchor()).
        .group-context-menu-item-btn(
            (click)='openWorkspaceMenuFromSwitcher($event, ws)',
            [title]="'Manage this workspace' | translate"
        )
            .fa.fa-fw.fas.fa-ellipsis-h
    a.group-context-menu-item((click)='openCreateWorkspaceFromSwitcher($event)', href='#')
        .fa.fa-fw.fas.fa-plus.me-2
        | {{ 'New workspace...' | translate }}

