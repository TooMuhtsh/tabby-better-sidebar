.p-2.h-100.d-flex.flex-column
    input.form-control.form-control-sm.mb-1(
        type='text',
        [(ngModel)]='filter',
        placeholder='Filter',
        (ngModelChange)='onFilterChange()'
    )

    .sidebar-plus-tree.h-100((contextmenu)='onSidebarContextMenu($event)')
        .d-flex.flex-column.p-2.sidebar-plus-tree-container(
            cdkDropList,
            id='groups-root',
            [cdkDropListData]='rootGroups',
            [cdkDropListConnectedTo]='groupListIds',
            (cdkDropListDropped)='onGroupDrop($event, null)'
        )
            ng-container(*ngFor='let group of rootGroups')
                div(cdkDrag, [cdkDragData]='group', [cdkDragDisabled]='!group.editable')
                    .group-drag-preview(*cdkDragPreview)
                        profile-icon([icon]='group.icon ?? "far fa-folder"', [color]='group.color')
                        span.ms-2 {{ group.name || 'Ungrouped' }}
                    ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: group, depth: 0}')

            ng-template(#recursiveGroup let-group let-depth='depth')
                a.tree-item(
                    (click)='toggleGroupCollapse(group)',
                    (contextmenu)='onGroupContextMenu($event, group)',
                    [style.paddingLeft.px]='depth * 20',
                    href='#'
                )
                    .fw-20
                        .fa.fa-fw.fas.fa-chevron-right.ms-1.text-muted(*ngIf='group.collapsed')
                        .fa.fa-fw.fas.fa-chevron-down.ms-1.text-muted(*ngIf='!group.collapsed')
                    .fw-20
                        profile-icon.ms-1([icon]='group.icon ?? "far fa-folder"', [color]='group.color')
                    span.ms-2.me-auto {{ group.name || 'Ungrouped' }}

                ng-container(*ngIf='!group.collapsed')
                    div(
                        cdkDropList,
                        [id]='"profiles-" + group.id',
                        [cdkDropListData]='group.profiles',
                        [cdkDropListConnectedTo]='profileListIds',
                        (cdkDropListDropped)='onProfileDrop($event, group)'
                    )
                        ng-container(*ngFor='let profile of group.profiles')
                            a.tree-item(
                                cdkDrag,
                                [cdkDragData]='profile',
                                (dblclick)='launchProfile(profile)',
                                (contextmenu)='onProfileContextMenu($event, profile)',
                                [style.paddingLeft.px]='(depth + 1) * 20',
                                href='#'
                            )
                                .fw-20
                                    profile-icon.ms-1([icon]='profile.icon', [color]='profile.color')
                                span.status-dot.ms-1(
                                    [class.status-dot-connected]='getProfileStatus(profile) === "connected"',
                                    [class.status-dot-error]='getProfileStatus(profile) === "error"',
                                    [title]='getProfileStatus(profile) === "connected" ? "Connecté" : getProfileStatus(profile) === "error" ? "Déconnecté" : "Aucune session"'
                                )
                                span.ms-2.no-wrap {{ profile.name }}
                                .fa.fa-fw.fas.fa-star.ms-1.favorite-badge(*ngIf='isFavorite(profile)')

                                .actions
                                    .action((click)='toggleFavorite(profile, $event)')
                                        .fa.fa-fw(
                                            [class.fas]='isFavorite(profile)',
                                            [class.far]='!isFavorite(profile)',
                                            class='fa-star'
                                        )
                                    .action((click)='launchProfile(profile)')
                                        .fa.fa-fw.fas.fa-play

                    div(
                        cdkDropList,
                        [id]='"groups-" + group.id',
                        [cdkDropListData]='group.children',
                        [cdkDropListConnectedTo]='groupListIds',
                        (cdkDropListDropped)='onGroupDrop($event, group.id)'
                    )
                        ng-container(*ngFor='let child of group.children')
                            div(cdkDrag, [cdkDragData]='child', [cdkDragDisabled]='!child.editable')
                                .group-drag-preview(*cdkDragPreview)
                                    profile-icon([icon]='child.icon ?? "far fa-folder"', [color]='child.color')
                                    span.ms-2 {{ child.name || 'Ungrouped' }}
                                ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: child, depth: depth + 1}')
.grabber(
    [class.resizing]='panelIsResizing',
    (mousedown)='startResize($event)'
)

.group-context-menu(
    *ngIf='contextMenuGroup && isMenuMode',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    a.group-context-menu-item((click)='openCreateGroupPrompt()', href='#')
        .fa.fa-fw.fas.fa-folder-plus.me-2
        | Nouveau dossier...
    a.group-context-menu-item((click)='openCreateProfilePicker()', href='#')
        .fa.fa-fw.fas.fa-plus.me-2
        | Nouveau profil...
    a.group-context-menu-item((click)='openIconPicker()', href='#')
        .fa.fa-fw.fas.fa-icons.me-2
        | Changer l'icône...
    a.group-context-menu-item((click)='deleteGroup(contextMenuGroup)', href='#')
        .fa.fa-fw.fas.fa-trash.me-2
        | Supprimer

.group-context-menu(
    *ngIf='contextMenuRoot && isMenuMode',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    a.group-context-menu-item((click)='openCreateGroupPrompt()', href='#')
        .fa.fa-fw.fas.fa-folder-plus.me-2
        | Nouveau dossier...
    a.group-context-menu-item((click)='openCreateProfilePicker()', href='#')
        .fa.fa-fw.fas.fa-plus.me-2
        | Nouveau profil...

.group-context-menu(
    *ngIf='contextMenuProfile && isMenuMode',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    a.group-context-menu-item((click)='openProfileSettings(contextMenuProfile)', href='#')
        .fa.fa-fw.fas.fa-pen.me-2
        | Éditer...
    a.group-context-menu-item((click)='openIconPicker()', href='#')
        .fa.fa-fw.fas.fa-icons.me-2
        | Changer l'icône...
    a.group-context-menu-item((click)='confirmDeleteProfile()', href='#')
        .fa.fa-fw.fas.fa-trash.me-2
        | Supprimer

.icon-picker(
    *ngIf='isIconPickerMode && (contextMenuGroup || contextMenuProfile)',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    .icon-picker-header
        span Choisir une icône
        a.icon-picker-close((click)='closeContextMenu()', href='#') ×

    .text-muted.small(*ngIf='recentIcons.length && !iconQuery') Récentes
    .icon-picker-grid(*ngIf='recentIcons.length && !iconQuery')
        a.icon-picker-item(
            *ngFor='let c of recentIcons',
            (click)='selectIconClass(c)',
            [title]='c',
            href='#'
        )
            profile-icon([icon]='c')

    input.form-control.form-control-sm.mb-1.mt-1(
        type='text',
        [(ngModel)]='iconQuery',
        placeholder='Rechercher (ex: server, folder, star...)',
        (ngModelChange)='onIconQueryChange()'
    )
    .icon-picker-grid(*ngIf='iconMatches.length')
        a.icon-picker-item(
            *ngFor='let e of iconMatches',
            (click)='selectIconClass(e.value)',
            [title]='e.name',
            href='#'
        )
            profile-icon([icon]='e.value')

    hr

    .icon-picker-custom
        a.small((click)='toggleCustomSvgInput()', href='#') Importer à partir d'un SVG...

        ng-container(*ngIf='showCustomSvgInput')
            textarea.form-control.form-control-sm.mt-1(
                rows='3',
                [(ngModel)]='customSvgText',
                placeholder='<svg viewBox="0 0 24 24">...</svg>'
            )
            .text-danger.small.mt-1(*ngIf='customSvgError') {{ customSvgError }}
            .text-warning.small.mt-1(*ngIf='customSvgWarning') {{ customSvgWarning }}
            button.btn.btn-sm.btn-secondary.mt-1((click)='applyCustomSvg()') Appliquer le SVG

.create-popup(
    *ngIf='isCreateGroupMode',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    .icon-picker-header
        span Nouveau dossier
        a.icon-picker-close((click)='closeContextMenu()', href='#') ×
    input.form-control.form-control-sm.mt-1(
        type='text',
        [(ngModel)]='newGroupName',
        placeholder='Nom du dossier',
        (keydown.enter)='createGroup()'
    )
    button.btn.btn-sm.btn-primary.mt-2((click)='createGroup()') Créer

.create-popup(
    *ngIf='isCreateProfileMode',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    .icon-picker-header
        span Nouveau profil
        a.icon-picker-close((click)='closeContextMenu()', href='#') ×
    .create-profile-list
        a.create-profile-item(
            *ngFor='let e of profileTemplates',
            (click)='pickProfileTemplate(e)',
            href='#'
        )
            profile-icon.me-2([icon]='e.template.icon')
            span {{ e.template.name }}

.create-popup(
    *ngIf='isConfirmDeleteProfileMode && contextMenuProfile',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    .icon-picker-header
        span Supprimer le profil
        a.icon-picker-close((click)='closeContextMenu()', href='#') ×
    .small.mb-2 Supprimer « {{ contextMenuProfile.name }} » ? Cette action est irréversible.
    .d-flex.gap-2
        button.btn.btn-sm.btn-danger((click)='deleteProfile(contextMenuProfile)') Supprimer
        button.btn.btn-sm.btn-secondary((click)='closeContextMenu()') Annuler
