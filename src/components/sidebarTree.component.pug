//- Footer bar at the bottom of the sidebar, in both views. Plugin signature +
//- version on the left, settings gear on the right. Deliberately outside the
//- profiles/SFTP *ngIf blocks: it belongs to the plugin, not to either view.
//- A flow member of the tag's flex column, below the clipped content region —
//- nothing can geometrically enter its strip, and its background is opaque by
//- construction (see the SCSS), translucent themes included.
.sidebar-plus-footer
    .sidebar-plus-footer-brand.no-wrap
        span.footer-name better-sidebar
        span.footer-by  by TooMuhtsh
        span.footer-version v{{ pluginVersion }}
