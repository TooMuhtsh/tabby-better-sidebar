.p-2.h-100.d-flex.flex-column
    //- Kept as the very first row, above the workspace bar, so it stays put
    //- when switching modes instead of sliding around under the cursor.
    .view-mode-bar.d-flex.align-items-center
        a.view-mode-tab(
            [class.active]='!sftpMode',
            (click)='setSftpMode(false)',
            title='Profils',
            href='#'
        )
            .fa.fa-fw.fas.fa-list.me-1
            span Profils
        a.view-mode-tab(
            [class.active]='sftpMode',
            (click)='setSftpMode(true)',
            title='SFTP de la session active',
            href='#'
        )
            .fa.fa-fw.fas.fa-folder-open.me-1
            span SFTP

    //- Hidden outright when nothing is connected rather than shown empty: a
    //- permanently visible "aucune session" header would cost a line of the
    //- tree for no information. Stays visible in SFTP mode too — an open
    //- session is a fact of the app, not something the current sidebar tab
    //- should hide (same reasoning as its own SFTP-mode independence, see
    //- ROADMAP #sessions-actives).
    //-
    //- Placed *before* <sidebar-plus-sftp>, not after: the panel is
    //- `flex-grow-1` in this flex column, so anything following it gets pushed
    //- to the very bottom of the sidebar in SFTP mode. The section is meant to
    //- sit at the top in both tabs.
    .active-sessions(*ngIf='activeSessions.length')
        a.active-sessions-header((click)='toggleActiveSessions()', href='#')
            .fa.fa-fw.fas.me-1(
                [class.fa-chevron-down]='!activeSessionsCollapsed',
                [class.fa-chevron-right]='activeSessionsCollapsed'
            )
            span.me-auto Sessions actives
            span.active-sessions-count {{ activeSessions.length }}
        //- The list scrolls past four rows (see the SCSS): the header has to
        //- stay put, so the cap goes on this inner wrapper, not on the section.
        .active-sessions-list(*ngIf='!activeSessionsCollapsed')
            //- The SFTP shortcut is a div inside .actions, not a nested <a>:
            //- the row itself is an <a>, and an anchor inside an anchor is
            //- invalid HTML that the parser silently un-nests. Same shape as
            //- the profile rows' own .actions block below.
            a.active-session(
                *ngFor='let session of activeSessions',
                [class.focused]='session.focused',
                (click)='focusSession(session, $event)',
                (mouseenter)='onSessionHover(session, true)',
                (mouseleave)='onSessionHover(session, false)',
                [title]='sessionTooltip(session)',
                href='#'
            )
                //- The row's one dot, carrying the latency colour: in this
                //- section every row is a live session by construction, so a
                //- permanently green "connected" dot said nothing. It carries
                //- no tooltip of its own — the figures are in the row's, which
                //- is reachable from anywhere along it.
                span.status-dot.ms-1([ngClass]='sessionDotClass(session)')
                .fw-20
                    profile-icon.ms-1([icon]='session.icon', [color]='session.color')
                span.ms-2.me-auto.no-wrap {{ session.name }}
                //- Uptime on the row rather than in the tooltip only: it is the
                //- kind of thing one reads by scanning the list, not by aiming
                //- at a dot. Covered by .actions on hover, which is fine — the
                //- tooltip repeats it.
                span.session-uptime.no-wrap {{ sessionUptime(session) }}
                .actions
                    .action(
                        (click)='openSessionSftp(session, $event)',
                        title='Ouvrir le SFTP de cette session'
                    )
                        .fa.fa-fw.fas.fa-folder-open

    //- Mirrors Tabby's own forwarding state, never drives it: the roadmap frames
    //- this chantier as a "surcouche visuelle" over the native engine. Sits
    //- under the sessions it belongs to rather than at the very bottom of the
    //- sidebar as first sketched — the tree below is height-constrained, and a
    //- second live-state block reads better next to the first. Unlike the
    //- sessions block above, this one is hidden in SFTP mode: the user asked
    //- for it explicitly (2026-07-30), the SFTP tab having no use for the
    //- forwarding state.
    .active-tunnels(*ngIf='!sftpMode && activeTunnels.length')
        a.active-sessions-header((click)='toggleActiveTunnels()', href='#')
            .fa.fa-fw.fas.me-1(
                [class.fa-chevron-down]='!activeTunnelsCollapsed',
                [class.fa-chevron-right]='activeTunnelsCollapsed'
            )
            span.me-auto Tunnels actifs
            span.active-sessions-count {{ activeTunnels.length }}
        div(*ngIf='!activeTunnelsCollapsed')
            //- The row shows the description the user gave the tunnel; the
            //- technical form is one click away rather than in the way. Action
            //- buttons are divs, never nested <a> — the parser un-nests those
            //- silently and breaks the row (piège #38).
            ng-container(*ngFor='let tunnel of activeTunnels; let i = index')
                a.active-tunnel(
                    (click)='toggleTunnelDetails(i, $event)',
                    [title]='tunnel.detail',
                    href='#'
                )
                    .fa.fa-fw.fas.fa-link.ms-1.tunnel-icon
                    span.ms-2.me-auto.no-wrap {{ tunnel.label }}
                    span.tunnel-session.no-wrap {{ tunnel.sessionName }}
                    .actions
                        .action(
                            *ngIf='tunnel.url',
                            (click)='openTunnelUrl(tunnel, $event)',
                            [title]='"Ouvrir " + tunnel.url + " dans le navigateur"'
                        )
                            .fa.fa-fw.fas.fa-arrow-up-right-from-square
                        .action(
                            (click)='focusTunnelSession(tunnel, $event)',
                            title='Aller à la session'
                        )
                            .fa.fa-fw.fas.fa-terminal
                //- Session name stays on the row itself, so the unfolded part
                //- only adds what the row cannot show: the technical form.
                .tunnel-details(*ngIf='expandedTunnelIndex === i')
                    .no-wrap {{ tunnel.detail }}

    //- Deliberately [hidden] and not *ngIf: destroying this component would
    //- destroy its cached SFTP panels too, and rebuilding one opens a fresh
    //- SFTP channel that nothing closes (SFTPSession has no close(); the
    //- channel only dies with the SSH session). [active] is what keeps it
    //- idle while the tree is showing — see the component's `active` input.
    sidebar-plus-sftp.flex-grow-1(
        [hidden]='!sftpMode',
        [active]='sftpMode',
        (closed)='setSftpMode(false)'
    )

    //- Placed *after* <sidebar-plus-sftp> precisely because the panel is
    //- flex-grow-1: anything following it is pushed to the very bottom, which
    //- is where this one belongs. It is the mirror image of the sessions block
    //- above, whose comment explains the same mechanism the other way round.
    //-
    //- Shown in both views, not only in SFTP: a transfer started from the SFTP
    //- panel keeps running after switching back to the profiles, and losing
    //- sight of it there would be the one moment it matters.
    sidebar-plus-transfers

    .workspace-bar.d-flex.align-items-center.flex-wrap(*ngIf='!sftpMode')
        a.workspace-tab(
            [class.active]='activeWorkspaceId === "all"',
            (click)='selectWorkspace("all")',
            href='#'
        ) Tous
        a.workspace-tab(
            *ngFor='let ws of workspaces',
            [class.active]='activeWorkspaceId === ws.id',
            (click)='selectWorkspace(ws.id)',
            (contextmenu)='onWorkspaceTabContextMenu($event, ws)',
            [title]='ws.name',
            href='#'
        ) {{ ws.name }}
        a.workspace-tab.workspace-tab-add(
            (click)='openCreateWorkspacePrompt($event)',
            title='Nouveau workspace',
            href='#'
        )
            .fa.fa-fw.fas.fa-plus

    .d-flex.align-items-center.gap-1.mb-1(*ngIf='!sftpMode')
        //- `#filterInput=''`, not `#filterInput`: in pug a leading `#` is id
            syntax, so an Angular template reference has to be written as a
            quoted attribute to survive compilation. Read by @ViewChild.
        input.form-control.form-control-sm(
            #filterInput='',
            type='text',
            [(ngModel)]='filter',
            placeholder='Filtrer (Ctrl+F)',
            (ngModelChange)='onFilterChange()',
            (keydown.escape)='clearFilter()'
        )
        button.btn.btn-sm.btn-hidden-toggle(
            *ngIf='activeWorkspace',
            type='button',
            [class.active]='showHiddenPanel',
            (click)='showHiddenPanel = !showHiddenPanel',
            title='Éléments masqués dans ce workspace'
        )
            .fa.fa-fw.fas.fa-eye-slash

    //- Readout of the current selection and reminder of both gestures. Shown
    //- from one profile on: the count is the only statement of how many rows
    //- are held, since the rows themselves may have scrolled out of sight.
    //- Doubles as the transient confirmation once a move lands.
    .selection-bar(*ngIf='(selectionActive || selectionNotice) && !sftpMode')
        .d-flex.align-items-center(*ngIf='selectionNotice')
            .fa.fa-fw.fas.fa-check.me-2
            span.me-auto {{ selectionNotice }}
        ng-container(*ngIf='!selectionNotice')
            .d-flex.align-items-center
                span.me-auto {{ selectedProfileIds.size }} profil{{ selectedProfileIds.size > 1 ? 's' : '' }} sélectionné{{ selectedProfileIds.size > 1 ? 's' : '' }}
                .selection-clear((click)='clearSelection()', title='Annuler la sélection')
                    .fa.fa-fw.fas.fa-xmark
            .selection-hint Glissez la sélection, ou clic droit sur le dossier de destination

    .hidden-items-panel(*ngIf='showHiddenPanel && !sftpMode')
        .text-muted.small(*ngIf='!hiddenGroupsInWorkspace.length && !hiddenProfilesInWorkspace.length') Aucun élément masqué dans ce workspace.
        .hidden-item(*ngFor='let g of hiddenGroupsInWorkspace')
            profile-icon.me-2([icon]='g.icon ?? "far fa-folder"', [color]='g.color')
            span.me-auto.no-wrap {{ g.name || 'Ungrouped' }}
            a.action((click)='restoreGroupInWorkspace(g)', title='Réafficher', href='#')
                .fa.fa-fw.fas.fa-eye
        .hidden-item(*ngFor='let p of hiddenProfilesInWorkspace')
            profile-icon.me-2([icon]='p.icon', [color]='p.color')
            span.me-auto.no-wrap {{ p.name }}
            a.action((click)='restoreProfileInWorkspace(p)', title='Réafficher', href='#')
                .fa.fa-fw.fas.fa-eye

    .sidebar-plus-tree.h-100(*ngIf='!showHiddenPanel && !sftpMode', (contextmenu)='onSidebarContextMenu($event)')
        .d-flex.flex-column.p-2.sidebar-plus-tree-container(
            cdkDropList,
            id='groups-root',
            [cdkDropListData]='rootGroups',
            [cdkDropListConnectedTo]='groupListIds',
            (cdkDropListDropped)='onGroupDrop($event, null)'
        )
            ng-container(*ngFor='let group of rootGroups')
                div(
                    cdkDrag,
                    cdkDragPreviewClass='sidebar-plus-drag-preview',
                    [cdkDragData]='group',
                    [cdkDragDisabled]='!group.editable || filtering',
                    (cdkDragStarted)='onGroupDragStarted(group)',
                    (cdkDragEnded)='onGroupDragEnded()'
                )
                    .group-drag-preview(*cdkDragPreview)
                        profile-icon([icon]='group.icon ?? "far fa-folder"', [color]='group.color')
                        span.ms-2 {{ group.name || 'Ungrouped' }}
                    ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: group, depth: 0}')

            ng-template(#recursiveGroup let-group let-depth='depth')
                a.tree-item(
                    [attr.data-group-id]='group.id',
                    (click)='toggleGroupCollapse(group)',
                    (contextmenu)='onGroupContextMenu($event, group)',
                    [style.paddingLeft.px]='depth * 20',
                    href='#'
                )
                    .fw-20
                        .fa.fa-fw.fas.fa-chevron-right.ms-1.text-muted(*ngIf='group.collapsed')
                        .fa.fa-fw.fas.fa-chevron-down.ms-1.text-muted(*ngIf='!group.collapsed')
                    .fw-20
                        profile-icon.ms-1([icon]='group.icon ?? "far fa-folder"', [color]='group.color')
                    span.ms-2.me-auto {{ group.name || 'Ungrouped' }}
                    .fa.fa-fw.fas.fa-star.ms-1.favorite-badge(*ngIf='isFavoriteGroup(group)')

                div(
                    cdkDropList,
                    [id]='"profiles-" + group.id',
                    [cdkDropListData]='group.profiles',
                    [cdkDropListConnectedTo]='profileListIds',
                    (cdkDropListDropped)='onProfileDrop($event, group)'
                )
                    ng-container(*ngIf='!group.collapsed')
                        ng-container(*ngFor='let profile of group.profiles')
                            a.tree-item(
                                cdkDrag,
                                cdkDragPreviewClass='sidebar-plus-drag-preview',
                                [cdkDragData]='profile',
                                [cdkDragDisabled]='filtering',
                                [class.selected]='isProfileSelected(profile)',
                                [class.drag-hidden]='isHiddenWhileDragging(profile)',
                                data-profile-row='1',
                                [attr.data-profile-id]='profile.id',
                                (cdkDragStarted)='onProfileDragStarted(profile)',
                                (cdkDragEnded)='onProfileDragEnded()',
                                (click)='onProfileClick(profile, group, $event)',
                                (dblclick)='launchProfile(profile)',
                                (contextmenu)='onProfileContextMenu($event, profile)',
                                [style.paddingLeft.px]='(depth + 1) * 20',
                                href='#'
                            )
                                //- Custom preview so a multi-selection drag
                                //- carries a single card with a count, instead
                                //- of CDK's default clone of the one row that
                                //- happened to be grabbed.
                                .profile-drag-preview(*cdkDragPreview)
                                    profile-icon([icon]='profile.icon', [color]='profile.color')
                                    span.ms-2 {{ profile.name }}
                                    span.drag-count(*ngIf='selectedProfileIds.size > 1 && isProfileSelected(profile)') +{{ selectedProfileIds.size - 1 }}
                                .fw-20
                                    profile-icon.ms-1([icon]='profile.icon', [color]='profile.color')
                                span.status-dot.ms-1(
                                    [class.status-dot-connected]='getProfileStatus(profile) === "connected"',
                                    [class.status-dot-error]='getProfileStatus(profile) === "error"',
                                    [title]='getProfileStatus(profile) === "connected" ? "Connecté" : getProfileStatus(profile) === "error" ? "Déconnecté" : "Aucune session"'
                                )
                                span.ms-2.no-wrap {{ profile.name }}
                                .fa.fa-fw.fas.fa-star.ms-1.favorite-badge(*ngIf='isFavorite(profile)')
                                //- Two states, one badge: lit when forwards are
                                //- actually mounted, dimmed when the profile
                                //- merely carries some in its configuration.
                                .tunnel-badge.ms-1(
                                    *ngIf='tunnelCount(profile)',
                                    [title]='tunnelCount(profile) + " tunnel(s) monté(s) sur cette session"'
                                )
                                    .fa.fa-fw.fas.fa-link
                                .tunnel-badge.tunnel-badge-idle.ms-1(
                                    *ngIf='!tunnelCount(profile) && configuredTunnelCount(profile)',
                                    [title]='configuredTunnelCount(profile) + " tunnel(s) configuré(s) — montés au lancement de la session"'
                                )
                                    .fa.fa-fw.fas.fa-link

                                .actions
                                    .action((click)='toggleFavorite(profile, $event)')
                                        .fa.fa-fw(
                                            [class.fas]='isFavorite(profile)',
                                            [class.far]='!isFavorite(profile)',
                                            class='fa-star'
                                        )
                                    .action((click)='launchProfile(profile)')
                                        .fa.fa-fw.fas.fa-play

                // cdkDropList kept in the DOM even while collapsed (only the
                // rows inside are conditionally hidden) — a *ngIf on the
                // whole block used to unmount it entirely when collapsed,
                // so CDK never registered it as a connected drop target and
                // dragging a folder onto a collapsed one showed no drop zone
                // at all (see .sidebar-plus-tree min-height rule in the
                // scss, which keeps it a reachable ~8px target either way).
                div(
                    cdkDropList,
                    [id]='"groups-" + group.id',
                    [cdkDropListData]='group.children',
                    [cdkDropListConnectedTo]='groupListIds',
                    (cdkDropListDropped)='onGroupDrop($event, group.id)'
                )
                    ng-container(*ngIf='!group.collapsed')
                        ng-container(*ngFor='let child of group.children')
                            div(
                                cdkDrag,
                                cdkDragPreviewClass='sidebar-plus-drag-preview',
                                [cdkDragData]='child',
                                [cdkDragDisabled]='!child.editable',
                                (cdkDragStarted)='onGroupDragStarted(child)',
                                (cdkDragEnded)='onGroupDragEnded()'
                            )
                                .group-drag-preview(*cdkDragPreview)
                                    profile-icon([icon]='child.icon ?? "far fa-folder"', [color]='child.color')
                                    span.ms-2 {{ child.name || 'Ungrouped' }}
                                ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: child, depth: depth + 1}')
.grabber(
    [class.resizing]='panelIsResizing',
    (mousedown)='startResize($event)'
)

//- Reduced menu for 'ungrouped': not editable, so nothing on the normal folder
//- menu applies to it, but it IS a legal move target (onProfileDrop() accepts
//- it) — without this the drag could drop profiles there and the menu could not.
.group-context-menu(
    *ngIf='contextMenuGroup && isMenuMode && !contextMenuGroup.editable',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    .group-context-menu-header
        profile-icon.me-2([icon]='contextMenuGroup.icon ?? "far fa-folder"', [color]='contextMenuGroup.color')
        span.no-wrap {{ contextMenuGroup.name || 'Ungrouped' }}
    a.group-context-menu-item((click)='moveSelectionToGroup(contextMenuGroup)', href='#')
        .fa.fa-fw.fas.fa-arrow-right-to-bracket.me-2
        | Déplacer la sélection ici ({{ selectedProfileIds.size }})

.group-context-menu(
    *ngIf='contextMenuGroup && isMenuMode && contextMenuGroup.editable',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    .group-context-menu-header
        profile-icon.me-2([icon]='contextMenuGroup.icon ?? "far fa-folder"', [color]='contextMenuGroup.color')
        span.no-wrap {{ contextMenuGroup.name || 'Ungrouped' }}
    a.group-context-menu-item(*ngIf='canMoveSelectionTo(contextMenuGroup)', (click)='moveSelectionToGroup(contextMenuGroup)', href='#')
        .fa.fa-fw.fas.fa-arrow-right-to-bracket.me-2
        | Déplacer la sélection ici ({{ selectedProfileIds.size }})
    a.group-context-menu-item((click)='launchGroupSessions(contextMenuGroup)', href='#')
        .fa.fa-fw.fas.fa-play.me-2
        | Lancer toutes les sessions
    a.group-context-menu-item((click)='toggleFavoriteGroupFromMenu(contextMenuGroup, $event)', href='#')
        .fa.fa-fw.me-2(
            [class.fas]='isFavoriteGroup(contextMenuGroup)',
            [class.far]='!isFavoriteGroup(contextMenuGroup)',
            class='fa-star'
        )
        | {{ isFavoriteGroup(contextMenuGroup) ? 'Retirer des favoris' : 'Ajouter aux favoris' }}
    a.group-context-menu-item((click)='openRenamePrompt()', href='#')
        .fa.fa-fw.fas.fa-i-cursor.me-2
        | Renommer...
    a.group-context-menu-item((click)='openCreateGroupPrompt()', href='#')
        .fa.fa-fw.fas.fa-folder-plus.me-2
        | Nouveau dossier...
    a.group-context-menu-item((click)='openCreateProfilePicker()', href='#')
        .fa.fa-fw.fas.fa-plus.me-2
        | Nouveau profil...
    a.group-context-menu-item((click)='openIconPicker()', href='#')
        .fa.fa-fw.fas.fa-icons.me-2
        | Changer l'icône...
    a.group-context-menu-item(*ngIf='activeWorkspace', (click)='hideInActiveWorkspace()', href='#')
        .fa.fa-fw.fas.fa-eye-slash.me-2
        | Cacher dans le workspace
    a.group-context-menu-item((click)='deleteGroup(contextMenuGroup)', href='#')
        .fa.fa-fw.fas.fa-trash.me-2
        | Supprimer

.group-context-menu(
    *ngIf='contextMenuRoot && isMenuMode',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    a.group-context-menu-item((click)='openCreateGroupPrompt()', href='#')
        .fa.fa-fw.fas.fa-folder-plus.me-2
        | Nouveau dossier...
    a.group-context-menu-item((click)='openCreateProfilePicker()', href='#')
        .fa.fa-fw.fas.fa-plus.me-2
        | Nouveau profil...

.group-context-menu(
    *ngIf='contextMenuProfile && isMenuMode',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    .group-context-menu-header
        profile-icon.me-2([icon]='contextMenuProfile.icon', [color]='contextMenuProfile.color')
        span.no-wrap {{ contextMenuProfile.name }}
    a.group-context-menu-item((click)='launchProfileFromMenu(contextMenuProfile)', href='#')
        .fa.fa-fw.fas.fa-play.me-2
        | Lancer la session
    a.group-context-menu-item((click)='toggleFavoriteFromMenu(contextMenuProfile, $event)', href='#')
        .fa.fa-fw.me-2(
            [class.fas]='isFavorite(contextMenuProfile)',
            [class.far]='!isFavorite(contextMenuProfile)',
            class='fa-star'
        )
        | {{ isFavorite(contextMenuProfile) ? 'Retirer des favoris' : 'Ajouter aux favoris' }}
    //- Single entry, editing the profile's own configuration. Handing over to
    //- Tabby's native modal for live sessions was built and then dropped at the
    //- user's request — see openProfileTunnels() for what that costs.
    a.group-context-menu-item(*ngIf='isSshProfileMenu', (click)='openProfileTunnels()', href='#')
        .fa.fa-fw.fas.fa-link.me-2
        | Tunnels du profil...
    a.group-context-menu-item((click)='openRenamePrompt()', href='#')
        .fa.fa-fw.fas.fa-i-cursor.me-2
        | Renommer...
    a.group-context-menu-item((click)='openProfileSettings(contextMenuProfile)', href='#')
        .fa.fa-fw.fas.fa-pen.me-2
        | Éditer...
    a.group-context-menu-item((click)='openIconPicker()', href='#')
        .fa.fa-fw.fas.fa-icons.me-2
        | Changer l'icône...
    a.group-context-menu-item(*ngIf='activeWorkspace', (click)='hideInActiveWorkspace()', href='#')
        .fa.fa-fw.fas.fa-eye-slash.me-2
        | Cacher dans le workspace
    a.group-context-menu-item((click)='confirmDeleteProfile()', href='#')
        .fa.fa-fw.fas.fa-trash.me-2
        | Supprimer

.icon-picker(
    *ngIf='isIconPickerMode && (contextMenuGroup || contextMenuProfile)',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    .icon-picker-header
        span Choisir une icône
        a.icon-picker-close((click)='closeContextMenu()', href='#') ×

    .text-muted.small(*ngIf='!iconQuery') Favoris
    .icon-picker-grid(*ngIf='favoriteIcons.length && !iconQuery')
        a.icon-picker-item(
            *ngFor='let c of favoriteIcons',
            (click)='selectIconClass(c)',
            (contextmenu)='onIconContextMenu($event, c)',
            [title]='c',
            href='#'
        )
            profile-icon([icon]='c')
    .icon-picker-empty(*ngIf='!favoriteIcons.length && !iconQuery')
        | Clic droit sur une icône → « Ajouter aux favoris »

    .text-muted.small(*ngIf='recentIcons.length && !iconQuery') Récentes
    .icon-picker-grid(*ngIf='recentIcons.length && !iconQuery')
        a.icon-picker-item(
            *ngFor='let c of recentIcons',
            (click)='selectIconClass(c)',
            (contextmenu)='onIconContextMenu($event, c)',
            [title]='c',
            href='#'
        )
            profile-icon([icon]='c')

    input.form-control.form-control-sm.mb-1.mt-1(
        type='text',
        [(ngModel)]='iconQuery',
        placeholder='Rechercher (ex: server, folder, star...)',
        (ngModelChange)='onIconQueryChange()'
    )
    .icon-picker-grid(*ngIf='iconMatches.length')
        a.icon-picker-item(
            *ngFor='let e of iconMatches',
            (click)='selectIconClass(e.value)',
            (contextmenu)='onIconContextMenu($event, e.value)',
            [title]='e.name',
            href='#'
        )
            profile-icon([icon]='e.value')

    hr

    .icon-picker-custom
        a.small((click)='toggleCustomSvgInput()', href='#') Importer à partir d'un SVG...

        ng-container(*ngIf='showCustomSvgInput')
            textarea.form-control.form-control-sm.mt-1(
                rows='3',
                [(ngModel)]='customSvgText',
                placeholder='<svg viewBox="0 0 24 24">...</svg>'
            )
            .text-danger.small.mt-1(*ngIf='customSvgError') {{ customSvgError }}
            .text-warning.small.mt-1(*ngIf='customSvgWarning') {{ customSvgWarning }}
            button.btn.btn-sm.btn-secondary.mt-1((click)='applyCustomSvg()') Appliquer le SVG

// Rendered outside .icon-picker: the picker's grids scroll (overflow-y),
// which would clip a menu overlapping a tile — the same clipping that made
// the first attempt, a star badge in the tile's corner, come out cut off.
.icon-context-menu(
    *ngIf='iconMenuIcon',
    [style.left.px]='iconMenuX',
    [style.top.px]='iconMenuY',
    (click)='$event.stopPropagation()'
)
    a.group-context-menu-item((click)='toggleFavoriteIconFromMenu($event)', href='#')
        profile-icon.me-2([icon]='iconMenuIcon')
        | {{ isFavoriteIcon(iconMenuIcon) ? 'Retirer des favoris' : 'Ajouter aux favoris' }}

.create-popup(
    *ngIf='isRenameMode',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    .icon-picker-header
        span Renommer
        a.icon-picker-close((click)='closeContextMenu()', href='#') ×
    input.form-control.form-control-sm.mt-1(
        type='text',
        [(ngModel)]='renameValue',
        (keydown.enter)='confirmRename()',
        (keydown.escape)='closeContextMenu()'
    )
    button.btn.btn-sm.btn-primary.mt-2((click)='confirmRename()') Renommer

.create-popup(
    *ngIf='isCreateGroupMode',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    .icon-picker-header
        span Nouveau dossier
        a.icon-picker-close((click)='closeContextMenu()', href='#') ×
    input.form-control.form-control-sm.mt-1(
        type='text',
        [(ngModel)]='newGroupName',
        placeholder='Nom du dossier',
        (keydown.enter)='createGroup()'
    )
    button.btn.btn-sm.btn-primary.mt-2((click)='createGroup()') Créer

.create-popup.tunnels-popup(
    *ngIf='isTunnelsMode && contextMenuProfile',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
    (click)='$event.stopPropagation()'
)
    .icon-picker-header
        span.no-wrap Tunnels — {{ contextMenuProfile.name }}
        a.icon-picker-close((click)='closeContextMenu()', href='#') ×
    .text-muted.small.mt-1(*ngIf='!profileTunnels.length') Aucun tunnel configuré sur ce profil.
    .tunnel-row(
        *ngFor='let fw of profileTunnels; let i = index',
        [class.editing]='editingTunnelIndex === i',
        (dblclick)='startEditTunnel(i)',
        title='Double-cliquez pour modifier ce tunnel'
    )
        span.me-auto.no-wrap {{ formatTunnelRow(fw) }}
        .action(
            *ngIf='!isTunnelLive(fw)',
            (click)='removeProfileTunnel(i)',
            title='Supprimer ce tunnel'
        )
            .fa.fa-fw.fas.fa-trash
        .action.disabled(
            *ngIf='isTunnelLive(fw)',
            title='Ce tunnel est actuellement monté sur la session ouverte. Le supprimer ici retirerait sa configuration sans couper le tunnel, qui continuerait de tourner jusqu\'à la fermeture de la session. Fermez la session pour pouvoir le supprimer.'
        )
            .fa.fa-fw.fas.fa-lock
    hr
    .d-flex.gap-1.mb-1
        select.form-control.form-control-sm.tunnel-type([(ngModel)]='tunnelDraft.type')
            option(*ngFor='let t of tunnelTypes', [value]='t') {{ t }}
        //- Placeholder says which machine listens; the hint below spells out
        //- which end resolves the destination, since that flips with the type.
        input.form-control.form-control-sm(
            type='number',
            [(ngModel)]='tunnelDraft.port',
            placeholder='Port d\'écoute',
            (keydown.enter)='addProfileTunnel()',
            (keydown.escape)='closeContextMenu()'
        )
    .d-flex.gap-1.mb-1(*ngIf='!isDynamicDraft')
        input.form-control.form-control-sm(
            type='text',
            [(ngModel)]='tunnelDraft.targetAddress',
            placeholder='Hôte cible'
        )
        input.form-control.form-control-sm(
            type='number',
            [(ngModel)]='tunnelDraft.targetPort',
            placeholder='Port cible',
            (keydown.enter)='addProfileTunnel()',
            (keydown.escape)='closeContextMenu()'
        )
    input.form-control.form-control-sm.mb-1(
        type='text',
        [(ngModel)]='tunnelDraft.description',
        placeholder='Description (optionnel)'
    )
    .tunnel-hint.small.mb-1 {{ tunnelHint }}
    .text-danger.small.mb-1(*ngIf='tunnelError') {{ tunnelError }}
    .d-flex.gap-2
        button.btn.btn-sm.btn-primary((click)='addProfileTunnel()') {{ editingTunnelIndex === null ? 'Ajouter le tunnel' : 'Enregistrer' }}
        button.btn.btn-sm.btn-secondary(*ngIf='editingTunnelIndex !== null', (click)='cancelEditTunnel()') Annuler
    .text-muted.small.mt-2 Prend effet au prochain lancement de la session.

.create-popup(
    *ngIf='isCreateProfileMode',
    [style.left.px]='contextMenuX',
    [style.top.px]='contextMenuY',
