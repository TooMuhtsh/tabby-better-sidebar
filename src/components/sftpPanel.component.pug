.sftp-host.d-flex.flex-column
    .sftp-bound-tab.d-flex.align-items-center(*ngIf='!waiting')
        .fa.fa-fw.fas.fa-server.me-1
        span.no-wrap.me-auto {{ boundTabTitle }}
        //- Only rendered inside `!waiting`, i.e. exactly when boundTab is set
        //- — freezing "nothing" has no meaning, see toggleFreeze().
        a.sftp-freeze-toggle(
            href='#',
            [class.active]='frozen',
            [title]="frozen ? ('Frozen view — click to follow focus again' | translate) : ('Freeze view on this session' | translate)",
            (click)='toggleFreeze()'
        )
            .fa.fa-fw.fas.fa-thumbtack

    .sftp-waiting.text-muted.small(*ngIf='waiting')
        .fa.fa-fw.fas.fa-plug.mb-2
        div {{ 'Waiting for an active SSH session.' | translate }}
        div.mt-1 {{ 'Open an SSH profile — the panel will follow the selected tab.' | translate }}

    //- Tabby's own SFTPPanelComponent is grafted in here by attachPanel().
    //- Hidden rather than *ngIf'd away while waiting: removing the container
    //- would drop the very node the cached panels are re-attached to.
    //-
    //- `#panelContainer=""` and not a bare `#panelContainer`: pug renders a
    //- valueless attribute as `name="name"` outside terse/HTML5 mode, and
    //- Angular reads `#ref="something"` as an exportAs lookup, which would
    //- fail at compile time. An explicitly empty value is the plain
    //- element-reference form.
    .sftp-panel-container.flex-grow-1(#panelContainer='', [hidden]='waiting')
