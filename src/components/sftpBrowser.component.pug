//- Presentation-only override of tabby-ssh's SFTPPanelComponent template.
//- Every handler and field below is inherited — see the component's doc
//- comment for why the template had to be ours.
//-
//- No expression here contains a string literal: pug escapes whichever quote
//- style it isn't using as the attribute delimiter, which corrupts Angular
//- expressions. Anything that needed one is a getter or a wrapper method.
.sftp-toolbar.d-flex.align-items-center
    input.form-control.form-control-sm.flex-grow-1(
        *ngIf='editingPath !== null',
        type='text',
        autofocus,
        (keydown.enter)='confirmPath()',
        (keydown.esc)='editingPath = null',
        (blur)='editingPath = null',
        [(ngModel)]='editingPath'
    )
    .sftp-breadcrumb.flex-grow-1(
        *ngIf='editingPath === null',
        (dblclick)='editPath()',
        title='Double-cliquer pour saisir un chemin'
    )
        a.crumb((click)='goRoot()') /
        a.crumb(*ngFor='let segment of pathSegments', (click)='navigate(segment.path)') {{ segment.name }}

    //- A title on every button: the captions the native template pairs with
    //- each icon do not fit a sidebar, and an icon on its own says nothing.
    button.btn.btn-link.btn-sm.sftp-tool(
        type='button',
        *ngIf='editingPath === null',
        (click)='editPath()',
        title='Saisir le chemin à la main'
    )
        .fa.fa-fw.fas.fa-pen
    button.btn.btn-link.btn-sm.sftp-tool(type='button', (click)='navigate(path)', title='Actualiser')
        .fa.fa-fw.fas.fa-sync-alt
    button.btn.btn-link.btn-sm.sftp-tool(type='button', *ngIf='!showFilter', (click)='showFilter = true', title='Filtrer la liste')
        .fa.fa-fw.fas.fa-filter
    button.btn.btn-link.btn-sm.sftp-tool(type='button', (click)='openCreateDirectoryModal()', title='Nouveau dossier distant')
        .fa.fa-fw.fas.fa-folder-plus
    button.btn.btn-link.btn-sm.sftp-tool(type='button', (click)='upload()', title='Envoyer des fichiers vers le serveur')
        .fa.fa-fw.fas.fa-file-upload
    button.btn.btn-link.btn-sm.sftp-tool(type='button', (click)='uploadFolder()', title='Envoyer un dossier vers le serveur')
        .fa.fa-fw.fas.fa-file-import

.sftp-filter-bar.d-flex.align-items-center(*ngIf='showFilter')
    input.form-control.form-control-sm.flex-grow-1(
        type='text',
        placeholder='Filtrer...',
        autofocus,
        [(ngModel)]='filterText',
        (input)='onFilterChange()',
        (keydown.escape)='clearFilter()'
    )
    button.btn.btn-link.btn-sm.sftp-tool(type='button', (click)='clearFilter()', title='Effacer le filtre')
        .fa.fa-fw.fas.fa-times

//- dropZone is tabby-core's DropZoneDirective, exported by TabbyCoreModule —
//- keeps drag-and-drop upload working exactly as in the native panel.
.sftp-body(dropZone, (transfer)='uploadOneFolder($event)', (contextmenu)='onBackgroundContextMenu($event)')
    .sftp-message(*ngIf='!sftp') Connexion...
    ng-container(*ngIf='sftp')
        .sftp-message(*ngIf='fileList === null') Chargement...
        .sftp-grid(
            *ngIf='fileList !== null',
            [class.with-col-borders]='showColumnBorders',
            [class.with-zebra]='showZebra'
        )
            .sftp-row.sftp-header-row([style.grid-template-columns]='gridTemplate')
                .cell-icon
                .cell-name Nom
                .cell-value(
                    *ngFor='let column of visibleColumns',
                    [class.cell-right]='column.numeric',
                    [title]='column.description'
                ) {{ column.label }}

            .sftp-row.sftp-row-up(
                *ngIf='canGoUp',
                [style.grid-template-columns]='gridTemplate',
                (click)='goUp()',
                title='Remonter d’un niveau'
            )
                .cell-icon
                    .fa.fa-fw.fas.fa-level-up-alt
                .cell-name ..
                .cell-value(*ngFor='let column of visibleColumns')

            //- The zebra class is driven by the loop index, not by
            //- :nth-child: the header is the first child and the "go up" row
            //- comes and goes, so a CSS-side parity would flip whenever the
            //- panel is at the root.
            .sftp-row(
                *ngFor='let item of displayedFiles; let i = index; trackBy: trackByPath',
                [style.grid-template-columns]='gridTemplate',
                [class.sftp-zebra]='i % 2 === 1',
                [class.sftp-dim]='isHidden(item)',
                [class.sftp-selected]='isSelected(item)',
                (click)='select(item)',
                (dblclick)='openItem(item)',
                (contextmenu)='showContextMenu(item, $event)',
                [title]='rowTooltip(item)'
            )
                .cell-icon
                    i.fa-fw([class]='getIcon(item)')
                .cell-name {{ item.name }}
                .cell-value(
                    *ngFor='let column of visibleColumns',
                    [class.cell-right]='column.numeric',
                    [title]='cellValue(column, item)'
                ) {{ cellValue(column, item) }}

        .sftp-message(*ngIf='filterFoundNothing') Aucun fichier ne correspond au filtre.

//- Both menus are rendered outside .sftp-body: they are `position: fixed`, and
//- living inside the scrolling element would let them drift with the list.
//- They share the .sftp-floating-menu class, which is the single hook used by
//- the outside-click handler and by the viewport clamping.
.sftp-floating-menu(
    *ngIf='backgroundMenuOpen',
    [style.left.px]='backgroundMenuX',
    [style.top.px]='backgroundMenuY'
)
    a.menu-item((click)='createDirectoryFromMenu()')
        .fa.fa-fw.fas.fa-folder-plus.me-2
        span Créer un dossier
    a.menu-item((click)='createFileFromMenu()')
        .fa.fa-fw.fas.fa-file-circle-plus.me-2
        span Créer un fichier
    .menu-separator
    a.menu-item((click)='openDisplayMenu()')
        .fa.fa-fw.fas.fa-table-columns.me-2
        span Paramètres d’affichage

//- Columns and display toggles, laid out as in SFTP+: the name column first
//- and permanently checked, then the optional ones, then the display options.
.sftp-floating-menu(
    *ngIf='displayMenuOpen',
    [style.left.px]='backgroundMenuX',
    [style.top.px]='backgroundMenuY'
)
    .menu-title Colonnes
    .menu-item.menu-item-disabled
        .menu-check ✓
        span Nom
    a.menu-item(*ngFor='let column of availableColumns', (click)='toggleColumn(column)', [title]='column.description')
        .menu-check {{ isColumnVisible(column) ? '✓' : '' }}
        span {{ column.description }}
    .menu-separator
    a.menu-item(*ngFor='let toggle of displayToggles', (click)='toggleDisplayOption(toggle.key)')
        .menu-check {{ isToggleOn(toggle.key) ? '✓' : '' }}
        span {{ toggle.label }}
