.modal-header
    h5.modal-title.no-wrap {{ 'Note: {name}' | translate:{ name: targetName } }}
    button.btn-close((click)='cancel()')

.modal-body
    //- Ctrl+Entrée saves, plain Entrée inserts a line break: a note is prose,
    //- so the newline has to be the cheaper of the two gestures.
    textarea.form-control(
        #field,
        rows='10',
        [(ngModel)]='text',
        [placeholder]="'Restart commands, maintenance reminders, ticket numbers…' | translate",
        (keydown.control.enter)='save()'
    )
    .text-muted.small.mt-2 {{ 'Clearing the field removes the note.' | translate }}

.modal-footer
    button.btn.btn-secondary((click)='cancel()') {{ 'Cancel' | translate }}
    button.btn.btn-primary((click)='save()') {{ 'Save' | translate }}
