.modal-header
    h5.modal-title.no-wrap Note — {{ targetName }}
    button.btn-close((click)='cancel()')

.modal-body
    //- Ctrl+Entrée saves, plain Entrée inserts a line break: a note is prose,
    //- so the newline has to be the cheaper of the two gestures.
    textarea.form-control(
        #field,
        rows='10',
        [(ngModel)]='text',
        placeholder='Commandes de relance, rappels de maintenance, numéros de tickets…',
        (keydown.control.enter)='save()'
    )
    .text-muted.small.mt-2 Vider le champ retire la note.

.modal-footer
    button.btn.btn-secondary((click)='cancel()') Annuler
    button.btn.btn-primary((click)='save()') Enregistrer
