//- Hidden whole when empty, like the sessions and tunnels blocks: an empty
//- header would cost sidebar height for nothing.
.sidebar-plus-transfers(*ngIf='transfers.entries.length')
    //- `.transfers-header` is this block's own class, not the tree's
    //- `.active-sessions-header`: that one is styled under
    //- `sidebar-plus-tree .active-sessions`, which never matched here — the
    //- header sat unstyled, without even `display: flex` (piège #56).
    a.transfers-header((click)='toggle($event)', href='#')
        .fa.fa-fw.fas.me-1(
            [class.fa-chevron-down]='!collapsed',
            [class.fa-chevron-right]='collapsed'
        )
        span {{ 'Transfers' | translate }}
        span.transfers-count(
            [class.active]='transfers.activeCount > 0',
            [title]='transfers.summaryTitle'
        ) {{ transfers.summary }}
        //- A div, never a nested <a>: an anchor inside an anchor is silently
        //- un-nested by the parser (piège #38). `ms-auto` pins it to the right
        //- edge, which only works now that the header is a flex container.
        .transfer-clear.ms-auto(
            (click)='clear($event)',
            [title]="'Clear the list — running transfers will be cancelled' | translate"
        )
            .fa.fa-fw.fas.fa-broom

    .transfers-list(*ngIf='!collapsed')
        .transfer-row(
            *ngFor='let entry of transfers.entries; trackBy: trackById',
            [class.transfer-done]='entry.state === "done"',
            [class.transfer-cancelled]='entry.state === "cancelled"',
            [class.transfer-failed]='entry.state === "failed" || entry.state === "unsound"',
            [title]='entry.tooltip'
        )
            .fa.fa-fw.fas.transfer-arrow(
                [class.fa-arrow-down]='entry.direction === "down"',
                [class.fa-arrow-up]='entry.direction === "up"'
            )
            //- Every value here is a plain field of the entry, never a call:
            //- change detection runs these expressions on every pass, and Tabby
            //- runs a great many passes (piège #54). The registry's tick is what
            //- keeps them fresh.
            span.transfer-name.no-wrap.me-auto {{ entry.name }}
            span.transfer-speed(*ngIf='entry.state === "active"') {{ entry.speedLabel }}
            span.transfer-figure(*ngIf='entry.state === "active"') {{ entry.percent }}%
            span.transfer-figure(*ngIf='entry.state === "done"') {{ entry.sizeLabel }}
            //- Our bytes are all served, but the file is not where it was
            //- dropped yet: the shell copies it there itself, and says nothing
            //- when it is done (piège #58). The wait shown is estimated from the
            //- size — deliberately generous, so the line never claims a file is
            //- in place before it can be.
            span.transfer-figure(
                *ngIf='entry.state === "handover"',
                [title]="'Transfer finished — the system is still placing the file at its destination. The shown duration is an estimate: nothing signals when this copy ends.' | translate"
            ) {{ 'handing over to the system…' | translate }}
            span.transfer-figure(*ngIf='entry.state === "cancelled"') {{ 'cancelled' | translate }}
            //- The percentage reached is kept alongside: "interrompu" alone
            //- does not say whether 2 % or 98 % had made it across.
            span.transfer-figure(
                *ngIf='entry.state === "failed"',
                [title]='entry.failureReason'
            ) {{ 'interrupted at {percent} %' | translate:{ percent: entry.percent } }}
            //- Finished, but the arrival check disagreed: the file at
            //- destination is missing or short. « interrompu » would be a lie —
            //- nothing broke mid-flight — hence its own label.
            span.transfer-figure(
                *ngIf='entry.state === "unsound"',
                [title]='entry.failureReason'
            ) {{ 'incomplete at destination' | translate }}
            //- Blank until a speed is known, and gone once there is nothing left
            //- to wait for — hence its own span rather than a suffix on the time.
            span.transfer-eta(*ngIf='entry.etaLabel', [title]="'Estimated time remaining' | translate") ~{{ entry.etaLabel }}
            span.transfer-time([title]="'Elapsed time' | translate") {{ entry.elapsedLabel }}
            //- A bin rather than a cross: on a finished line it removes, on a
            //- running one it cancels *and* removes — one gesture, one meaning.
            .transfer-remove(
                (click)='remove(entry, $event)',
                [title]="entry.state === 'active' ? ('Cancel this transfer and remove it' | translate) : ('Remove from the list' | translate)"
            )
                .fa.fa-fw.fas.fa-trash
